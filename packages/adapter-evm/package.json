{
  "name": "@receptum/adapter-evm",
  "version": "0.1.0",
  "description": "EVM rail for Base and Arc: USDC x402 payments, minimal escrow contract, receipt anchoring in release events.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "contracts:build": "forge build && node scripts/export-artifact.mjs",
    "contracts:test": "forge test"
  },
  "dependencies": {
    "@noble/curves": "^1.9.1",
    "@receptum/core": "workspace:*",
    "viem": "^2.57.2"
  },
  "author": "Swiftleads AI, Inc.",
  "homepage": "https://receptum-ai.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pez1980/receptum.git",
    "directory": "packages/adapter-evm"
  },
  "bugs": {
    "url": "https://github.com/Pez1980/receptum/issues"
  },
  "keywords": [
    "agents",
    "escrow",
    "proof-of-delivery",
    "receipts",
    "receptum",
    "x402"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
