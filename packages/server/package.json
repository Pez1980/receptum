{
  "name": "@receptum/server",
  "version": "0.1.0",
  "description": "Seller-side x402 middleware for Fastify and Express: price a route, answer HTTP 402, verify payment, issue receipts.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@receptum/core": "workspace:*",
    "@x402/core": "^2.28.0"
  },
  "author": "Swiftleads AI, Inc.",
  "homepage": "https://receptum-ai.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pez1980/receptum.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/Pez1980/receptum/issues"
  },
  "keywords": [
    "agents",
    "escrow",
    "proof-of-delivery",
    "receipts",
    "receptum",
    "x402"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "devDependencies": {
    "@receptum/adapter-evm": "workspace:*",
    "viem": "^2.57.2"
  }
}
