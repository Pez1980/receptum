{
  "name": "@receptum/verify",
  "version": "0.2.0",
  "description": "CLI and static page: hash a file, find its on-chain receipt, show who delivered what, when and for how much.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@receptum/core": "workspace:*",
    "@receptum/adapter-evm": "workspace:*",
    "@receptum/adapter-stellar": "workspace:*",
    "@receptum/adapter-xrpl": "workspace:*",
    "viem": "^2.57.2",
    "xrpl": "^5.3.0"
  },
  "bin": {
    "receptum-verify": "./dist/cli.js"
  },
  "author": "Swiftleads AI, Inc.",
  "homepage": "https://receptum-ai.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pez1980/receptum.git",
    "directory": "packages/verify"
  },
  "bugs": {
    "url": "https://github.com/Pez1980/receptum/issues"
  },
  "keywords": [
    "agents",
    "escrow",
    "proof-of-delivery",
    "receipts",
    "receptum",
    "x402"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
